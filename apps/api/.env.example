# ==========================================
# DIGICATLOG API ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5055
NODE_ENV=development

# Database Connection
# Local Development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digicatlog
# Production with Neon (pooled connection):
# DATABASE_URL=postgresql://user:pass@ep-cool-pooler.us-east-2.aws.neon.tech/digicatlog?sslmode=require&pgbouncer=true
# Direct connection for Prisma migrations on Neon:
# DIRECT_URL=postgresql://user:pass@ep-cool.us-east-2.aws.neon.tech/digicatlog?sslmode=require

# Authentication & Session Security (minimum 16 characters)
JWT_SECRET=super_secret_jwt_passphrase_min_16_chars_digicatlog_2025

# Client Origin (CORS and cookie domain matching)
CLIENT_ORIGIN=http://localhost:5185

# Cloudinary Storage (Optional in development - fallback saves to local ./uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Super Admin Initial Seed Credentials
SUPER_ADMIN_LOGIN=superadmin
SUPER_ADMIN_PASSWORD=Admin@DigiCatlog2025!
